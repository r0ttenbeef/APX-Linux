{
  "policies": {
    "Extensions": {
      "Install": [
{% for item in firefox_plugins %}
        "https://addons.mozilla.org/firefox/downloads/latest/{{ item }}/latest.xpi"{{ "," if not loop.last }}
{% endfor %}
      ]
    },
    "Homepage": {
      "URL": "https://r0ttenbeef.github.io/apx-homepage",
      "Locked": true,
      "StartPage": "homepage"
    },

    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    
    "Preferences": {
      "extension.activeThemeID": "nova-dusk@mozilla.org"
    }
  }
}
